# The site's own 42 application. It does exactly one thing: sign people in.
#
# No data is ever fetched on it. 42 meters per application, so a page load made
# on this key would compete with logging in -- browse hard enough and nobody
# can sign in until the hour rolls over. Visitors bring their own key for data.
CLIENT_ID1=
CLIENT_SECRET1=

# Signs the session cookie, and encrypts the 42 credentials visitors connect.
JWT_SECRET=

# Where the site is reachable, for the OAuth callback.
# In local development: http://localhost:3000
NEXTAUTH_URL=

# The piscine the site reports on. Used to be a hardcoded line in the cron repo.
POOL_MONTH=september
POOL_YEAR=

# Optional: the repository the changelog panel reads its commits from.
# Defaults to fZpHr/42insight.
GITHUB_REPO=
